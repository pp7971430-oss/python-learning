# ------------------------------------------
# Example 1: Student Information
# ------------------------------------------

name = "Priya"          # str
age = 18                # int
height = 5.5            # float
is_student = True       # bool

print("Name:", name)
print("Age:", age)
print("Height:", height)
print("Is Student:", is_student)


# ------------------------------------------
# Example 2: Product Information
# ------------------------------------------

product_name = "Laptop"     # str
quantity = 2                # int
price = 49999.99            # float
is_available = True         # bool

print("Product:", product_name)
print("Quantity:", quantity)
print("Price:", price)
print("Available:", is_available)


# ------------------------------------------
# Example 3: Exam Result
# ------------------------------------------

student_name = "Priya"
marks = 85
percentage = 85.5
passed = True

print("Student:", student_name)
print("Marks:", marks)
print("Percentage:", percentage)
print("Passed:", passed)


