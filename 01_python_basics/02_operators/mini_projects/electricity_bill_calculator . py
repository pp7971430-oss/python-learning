# ==========================================
# Electricity Bill Calculator
# ==========================================

print("==========================================")
print("       ELECTRICITY BILL CALCULATOR")
print("==========================================")

# Taking customer details
customer_name = input("Enter customer name: ")
units = int(input("Enter units consumed: "))

# Validate electricity units
if units < 0:
    print("Invalid input! Units cannot be negative.")

else:
    # Calculate bill according to electricity slabs

    # Slab 1: Up to 100 units → ₹5 per unit
    if units <= 100:
        bill = units * 5

    # Slab 2: 101 to 200 units
    elif units <= 200:
        bill = (100 * 5) + ((units - 100) * 7)

    # Slab 3: 201 to 300 units
    elif units <= 300:
        bill = (100 * 5) + (100 * 7) + ((units - 200) * 10)

    # Slab 4: Above 300 units
    else:
        bill = (100 * 5) + (100 * 7) + (100 * 10) + ((units - 300) * 12)

    # Display final electricity bill
    print("\n==========================================")
    print("              ELECTRICITY BILL")
    print("==========================================")
    print(f"Customer Name  : {customer_name}")
    print(f"Units Consumed : {units}")
    print(f"Total Bill     : ₹{bill}")
    print("==========================================")
    print("        Thank you for using our service!")
    print("==========================================")