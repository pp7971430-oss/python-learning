    print("Entry allowed.")
else:
    print("Entry not allowed.")


# Q7. Grade calculator.

marks = 78

print("\nQ7 - Grade")

if marks >= 90:
    print("A+")
elif marks >= 80:
    print("A")
elif marks >= 70:
    print("B")
elif marks >= 60:
    print("C")
elif marks >= 40:
    print("D")
else:
    print("F")